# Optional — public site origin for absolute SEO URLs (canonical, sitemap, OG).
# Set this in Vercel Production to your real domain, e.g.:
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Without it, builds fall back to VERCEL_URL (on Vercel) or http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Optional — reserved for a future AI itinerary provider.
# Leave empty for the local mock generator (default).
# Never commit real secrets.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_ITINERARY_ENDPOINT=
